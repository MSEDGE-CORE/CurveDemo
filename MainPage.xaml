                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="-4" Click="Sc_Click">
                        </Button>
                    </Grid>
                    <Grid CornerRadius="8" BorderBrush="Transparent" BorderThickness="0.5" VariableSizedWrapGrid.ColumnSpan="1" VariableSizedWrapGrid.RowSpan="1">
                        <Image Source="/Assets/IconRes/com.huawei.filemanager/background.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Image Source="/Assets/IconRes/com.huawei.filemanager/foreground.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="-4" Click="Sc_Click">
                        </Button>
                    </Grid>

                    <Grid CornerRadius="8" BorderBrush="Transparent" BorderThickness="1.0" VariableSizedWrapGrid.ColumnSpan="2" VariableSizedWrapGrid.RowSpan="2">

                        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch"  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"></Grid>
                        <Image Source="/Assets/CardRes/230620-Wide.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0" ScaleX="1.1" ScaleY="1.1"/>
                            </Image.RenderTransform>
                        </Image>

                        <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="-4" Click="Sc_Click">
                        </Button>
                    </Grid>
                    
                    <Grid CornerRadius="8" BorderBrush="Transparent" BorderThickness="0.5" VariableSizedWrapGrid.ColumnSpan="1" VariableSizedWrapGrid.RowSpan="1">
                        <Image Source="/Assets/IconRes/com.huawei.himovie/background.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
