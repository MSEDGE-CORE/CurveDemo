                        </Button>
                    </Grid>
                    <Grid CornerRadius="8" BorderBrush="Transparent" BorderThickness="0.5" VariableSizedWrapGrid.ColumnSpan="1" VariableSizedWrapGrid.RowSpan="1">
                        <Image Source="/Assets/IconRes/com.huawei.music/background.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Image Source="/Assets/IconRes/com.huawei.music/foreground.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="-4" Click="Sc_Click">
                        </Button>
                    </Grid>
                    <Grid CornerRadius="8" BorderBrush="Transparent" BorderThickness="1.0" VariableSizedWrapGrid.ColumnSpan="2" VariableSizedWrapGrid.RowSpan="1">

                        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch"  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"></Grid>
                        <Image Source="/Assets/CardRes/img35.jpg" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0" ScaleX="1.1" ScaleY="1.1"/>
                            </Image.RenderTransform>
                        </Image>

                        <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="-4" Click="Sc_Click">
                        </Button>
                    </Grid>


                    <Grid CornerRadius="8" BorderBrush="Transparent" BorderThickness="0.5" VariableSizedWrapGrid.ColumnSpan="1" VariableSizedWrapGrid.RowSpan="1">
                        <Image Source="/Assets/IconRes/com.android.calculator2/background.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Image Source="/Assets/IconRes/com.android.calculator2/foreground.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="-4" Click="Sc_Click">
                        </Button>
                    </Grid>
                    <Grid CornerRadius="8" BorderBrush="Transparent" BorderThickness="0.5" VariableSizedWrapGrid.ColumnSpan="1" VariableSizedWrapGrid.RowSpan="1">
                        <Image Source="/Assets/IconRes/com.huawei.appmarket/background.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Image Source="/Assets/IconRes/com.huawei.appmarket/foreground.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="-4" Click="Sc_Click">
                        </Button>
                    </Grid>
                    <Grid CornerRadius="8" BorderBrush="Transparent" BorderThickness="0.5" VariableSizedWrapGrid.ColumnSpan="1" VariableSizedWrapGrid.RowSpan="1">
                        <Image Source="/Assets/IconRes/com.huawei.health/background.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Image Source="/Assets/IconRes/com.huawei.health/foreground.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="-4" Click="Sc_Click">
                        </Button>
                    </Grid>
                    <Grid CornerRadius="8" BorderBrush="Transparent" BorderThickness="0.5" VariableSizedWrapGrid.ColumnSpan="1" VariableSizedWrapGrid.RowSpan="1">
                        <Image Source="/Assets/IconRes/com.huawei.smarthome/background.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Image Source="/Assets/IconRes/com.huawei.smarthome/foreground.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="-4" Click="Sc_Click">
                        </Button>
                    </Grid>


                    <Grid CornerRadius="8" BorderBrush="Transparent" BorderThickness="1.0" VariableSizedWrapGrid.ColumnSpan="4" VariableSizedWrapGrid.RowSpan="2">

                        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch"  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"></Grid>
                        <Image Source="/Assets/CardRes/03_gettyimages-591774121_super_resized.jpg" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0" ScaleX="1.1" ScaleY="1.1"/>
                            </Image.RenderTransform>
                        </Image>

                        <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="-4" Click="Sc_Click">
                        </Button>
                    </Grid>
                    <Grid CornerRadius="8" BorderBrush="Transparent" BorderThickness="0.5" VariableSizedWrapGrid.ColumnSpan="1" VariableSizedWrapGrid.RowSpan="1">
                        <Image Source="/Assets/IconRes/com.huawei.meetime/background.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Image Source="/Assets/IconRes/com.huawei.meetime/foreground.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="-4" Click="Sc_Click">
                        </Button>
                    </Grid>
                    <Grid CornerRadius="8" BorderBrush="Transparent" BorderThickness="0.5" VariableSizedWrapGrid.ColumnSpan="1" VariableSizedWrapGrid.RowSpan="1" Tag="com.android.camera">
                        <Image Source="/Assets/IconRes/com.android.camera/background.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Image Source="/Assets/IconRes/com.android.camera/foreground.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="-4" Click="Sc_Click">
                        </Button>
                    </Grid>
                    <Grid CornerRadius="8" BorderBrush="Transparent" BorderThickness="0.5" VariableSizedWrapGrid.ColumnSpan="1" VariableSizedWrapGrid.RowSpan="1">
                        <Image Source="/Assets/IconRes/com.android.gallery3d/background.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Image Source="/Assets/IconRes/com.android.gallery3d/foreground.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="-4" Click="Sc_Click">
                        </Button>
                    </Grid>
                    <Grid CornerRadius="8" BorderBrush="Transparent" BorderThickness="0.5" VariableSizedWrapGrid.ColumnSpan="1" VariableSizedWrapGrid.RowSpan="1">
                        <Image Source="/Assets/IconRes/com.android.browser/background.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Image Source="/Assets/IconRes/com.android.browser/foreground.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="-4" Click="Sc_Click">
                        </Button>
                    </Grid>

                </VariableSizedWrapGrid>
            </Grid>

            
            
            
            
            
            
            
            <Border x:Name="BlurBorder">
                <media:UIElementExtensions.VisualFactory >
                    <media:PipelineVisualFactory>
                        <media:BlurEffect x:Name="ImageBlurEffect" IsAnimatable="True" />
                    </media:PipelineVisualFactory>
                </media:UIElementExtensions.VisualFactory>
                <ani:Explicit.Animations>
                    <ani:AnimationSet x:Name="BlurAnimation" IsSequential="True">
                        <ani:BlurEffectAnimation x:Name="BlurAnSet" EasingMode="EaseOut" EasingType="Cubic" Target="{x:Bind ImageBlurEffect}" From="0" To="0" Duration="0:0:0.3" />
                    </ani:AnimationSet>
                </ani:Explicit.Animations>
            </Border>
            <Grid Name="BlurPointer">
                <Grid.Resources>
                    <Storyboard x:Name="BlurPointerStBo">
                        <DoubleAnimation x:Name="BlurPointerDA" Storyboard.TargetName="BlurPointerTransform" Storyboard.TargetProperty="X" From="0" To="20" >
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </Grid.Resources>
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="BlurPointerTransform" X="0" Y="0"/>
                </Grid.RenderTransform>
            </Grid>
            <Grid Name="RoundCornerPointer">
                <Grid.Resources>
                    <Storyboard x:Name="RoundCornerPointerStBo">
                        <DoubleAnimation x:Name="RoundCornerPointerDA" Duration="{x:Bind TrDur05}" Storyboard.TargetName="RoundCornerPointerTransform" Storyboard.TargetProperty="X" From="0" To="20" >
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </Grid.Resources>
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="RoundCornerPointerTransform" X="0" Y="0"/>
                </Grid.RenderTransform>
            </Grid>

            
            
            
            
            
            
            

            <Grid x:Name="AppRectGrid1" VerticalAlignment="Top" HorizontalAlignment="Stretch" BorderBrush="Red" BorderThickness="0">
                <Grid.Resources>
                    <Storyboard x:Name="AppRectGrid1StoryBoard">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AppRectGrid1Transform" Storyboard.TargetProperty="X" Duration="{x:Bind TrDur07}" EnableDependentAnimation="True">
                            <EasingDoubleKeyFrame x:Name="AppRectGrid1TransformSplineX" Value="0" KeyTime="{x:Bind TrDur07}" >
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <PowerEase EasingMode="EaseOut" Power="5.5"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AppRectGrid1Transform" Storyboard.TargetProperty="Y" Duration="{x:Bind TrDur07}" EnableDependentAnimation="True">
                            <EasingDoubleKeyFrame x:Name="AppRectGrid1TransformSplineY" Value="0" KeyTime="{x:Bind TrDur07}" >
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <PowerEase EasingMode="EaseOut" Power="5.5"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                    <Storyboard x:Name="AppRectGrid1Back">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AppRectGrid1Transform" Storyboard.TargetProperty="X" Duration="{x:Bind TrDur07}" EnableDependentAnimation="True">
                            <EasingDoubleKeyFrame x:Name="AppRectGrid1BackTransformSplineX" Value="0" KeyTime="{x:Bind TrDur07}" >
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <PowerEase x:Name="PowerEase1" EasingMode="EaseOut" Power="5.0"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AppRectGrid1Transform" Storyboard.TargetProperty="Y" Duration="{x:Bind TrDur07}" EnableDependentAnimation="True">
                            <EasingDoubleKeyFrame x:Name="AppRectGrid1BackTransformSplineY" Value="0" KeyTime="{x:Bind TrDur07}" >
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <PowerEase x:Name="PowerEase2" EasingMode="EaseOut" Power="5.0"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                    <Storyboard x:Name="AppRectGrid1BackCurveBounce">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AppRectGrid1Transform" Storyboard.TargetProperty="X" Duration="{x:Bind TrDur075}" EnableDependentAnimation="True">
                            <EasingDoubleKeyFrame x:Name="AppRectGrid1Back2TransformSplineX" Value="0" KeyTime="{x:Bind TrDur075}" >
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <BackEase x:Name="BackEase1" EasingMode="EaseOut" Amplitude="0.05"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AppRectGrid1Transform" Storyboard.TargetProperty="Y" Duration="{x:Bind TrDur075}" EnableDependentAnimation="True">
                            <EasingDoubleKeyFrame x:Name="AppRectGrid1Back2TransformSplineY" Value="0"  KeyTime="{x:Bind TrDur075}" >
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <BackEase x:Name="BackEase2" EasingMode="EaseOut" Amplitude="0.05"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </Grid.Resources>
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="AppRectGrid1Transform" X="0" Y="0"/>
                </Grid.RenderTransform>
                <Grid>
                    <Grid x:Name="AppRectGrid2" VerticalAlignment="Top" HorizontalAlignment="Left" BorderBrush="Orange" BorderThickness="0">
                        <Grid.Resources>
                            <Storyboard x:Name="AppRectGrid2StoryBoard">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AppRectGrid2Transform" Storyboard.TargetProperty="X" Duration="{x:Bind TrDur075}" EnableDependentAnimation="True">
                                        <EasingDoubleKeyFrame x:Name="AppRectGrid2TransformSplineX" Value="0" KeyTime="{x:Bind TrDur075}" >
                                        <EasingDoubleKeyFrame.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.2"/>
                                        </EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AppRectGrid2Transform" Storyboard.TargetProperty="Y" Duration="{x:Bind TrDur075}" EnableDependentAnimation="True">
                                    <EasingDoubleKeyFrame x:Name="AppRectGrid2TransformSplineY" Value="0" KeyTime="{x:Bind TrDur07}" >
                                        <EasingDoubleKeyFrame.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
                                        </EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                            <Storyboard x:Name="AppRectGrid2StoryBoard2">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AppRectGrid2Transform" Storyboard.TargetProperty="X" Duration="{x:Bind TrDur075}" EnableDependentAnimation="True">
                                    <EasingDoubleKeyFrame x:Name="AppRectGrid2Transform2SplineX" Value="0" KeyTime="{x:Bind TrDur075}" >
                                        <EasingDoubleKeyFrame.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.2"/>
                                        </EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AppRectGrid2Transform" Storyboard.TargetProperty="Y" Duration="{x:Bind TrDur075}" EnableDependentAnimation="True">
                                    <EasingDoubleKeyFrame x:Name="AppRectGrid2Transform2SplineY" Value="0" KeyTime="{x:Bind TrDur07}" >
                                        <EasingDoubleKeyFrame.EasingFunction>
                                            <BackEase EasingMode="EaseOut" Amplitude="0.5"/>
