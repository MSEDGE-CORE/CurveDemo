                            <Image.RenderTransform>
                                <ScaleTransform x:Name="iconBg1ScaleT" CenterX="0" CenterY="0" ScaleX="1.2" ScaleY="1.2"/>
                            </Image.RenderTransform>
                        </Image>
                        <Image x:Name="iconFg1" Source="/Assets/IconRes/com.android.settings/foreground.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform x:Name="iconFg1ScaleT" CenterX="0" CenterY="0" ScaleX="1.2" ScaleY="1.2"/>
                            </Image.RenderTransform>
                        </Image>
                        <Button VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Margin="-4" Click="Sc_Click">
                        </Button>
                    </Grid>
                    <Grid CornerRadius="8" BorderBrush="Transparent" BorderThickness="0.5" VariableSizedWrapGrid.ColumnSpan="1" VariableSizedWrapGrid.RowSpan="1">
