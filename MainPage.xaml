    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CurveDemo"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"      
    xmlns:ani="using:CommunityToolkit.WinUI.Animations"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True"
    SizeChanged="Page_SizeChanged"
    Loaded="Page_Loaded">

    <Grid Name="PageOutline" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Image Name="Wallpaper" Source="/Assets//IconRes/home_wallpaper03.jpg" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="UniformToFill">
            <Image.Resources>
                <Storyboard x:Name="WpStoryBoard">
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WpScaleT" Storyboard.TargetProperty="ScaleX" Duration="{x:Bind TrDur07}" EnableDependentAnimation="True">
                        <EasingDoubleKeyFrame x:Name="WpKeyFrameX" Value="0" KeyTime="{x:Bind TrDur07}" >
                            <EasingDoubleKeyFrame.EasingFunction>
                                <PowerEase EasingMode="EaseOut" Power="5"/>
                            </EasingDoubleKeyFrame.EasingFunction>
                        </EasingDoubleKeyFrame>
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="WpScaleT" Storyboard.TargetProperty="ScaleY" Duration="{x:Bind TrDur07}" EnableDependentAnimation="True">
                        <EasingDoubleKeyFrame x:Name="WpKeyFrameY" Value="0" KeyTime="{x:Bind TrDur07}" >
                            <EasingDoubleKeyFrame.EasingFunction>
                                <PowerEase EasingMode="EaseOut" Power="5"/>
                            </EasingDoubleKeyFrame.EasingFunction>
                        </EasingDoubleKeyFrame>
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
            </Image.Resources>
            <Image.RenderTransform>
                <ScaleTransform x:Name="WpScaleT" CenterX="0" CenterY="0" ScaleX="1.0" ScaleY="1.0"/>
            </Image.RenderTransform>
        </Image>
        <Grid>
            <Grid>
                <Grid.Resources>
                    <Storyboard x:Name="dskIconGridStoryBoard">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="dskIconScaleT" Storyboard.TargetProperty="ScaleX" Duration="{x:Bind TrDur07}" EnableDependentAnimation="True">
                            <EasingDoubleKeyFrame x:Name="dskIconKeyFrameX" Value="0" KeyTime="{x:Bind TrDur07}" >
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <PowerEase EasingMode="EaseOut" Power="5"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="dskIconScaleT" Storyboard.TargetProperty="ScaleY" Duration="{x:Bind TrDur07}" EnableDependentAnimation="True">
                            <EasingDoubleKeyFrame x:Name="dskIconKeyFrameY" Value="0" KeyTime="{x:Bind TrDur07}" >
                                <EasingDoubleKeyFrame.EasingFunction>
                                    <PowerEase EasingMode="EaseOut" Power="5"/>
                                </EasingDoubleKeyFrame.EasingFunction>
                            </EasingDoubleKeyFrame>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </Grid.Resources>
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="dskIconScaleT" CenterX="0" CenterY="0" ScaleX="1.0" ScaleY="1.0"/>
                </Grid.RenderTransform>
                <VariableSizedWrapGrid  Orientation="Horizontal" MaximumRowsOrColumns="4" Name="vDesktop" HorizontalAlignment="Center" VerticalAlignment="Stretch">
