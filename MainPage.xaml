                                <ScaleTransform CenterX="0" CenterY="0"/>
                            </Image.RenderTransform>
                        </Image>
                        <Image Source="/Assets/IconRes/com.android.email/foreground.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
