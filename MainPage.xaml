                            </Image.RenderTransform>
                        </Image>
                        <Image Source="/Assets/IconRes/com.huawei.himovie/foreground.png" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="UniformToFill">
                            <Image.RenderTransform>
